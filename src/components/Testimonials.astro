---
import { TESTIMONIALS } from '../data/testimonials';
import Icon from './Icon.astro';

/**
 * Horizontal auto-scrolling row rather than a grid. Ten quotes stacked two
 * across made a very tall section that a visitor had to commit to reading;
 * a moving row invites a glance and can hold any number of quotes without
 * changing the height of the page.
 *
 * The set is rendered twice so the track can loop seamlessly at -50%. The
 * second pass is aria-hidden, so assistive tech reads each quote once.
 */
const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();

interface Props {
  /** Caps how many enter the track. */
  limit?: number;
}

const { limit } = Astro.props;
const items = limit ? TESTIMONIALS.slice(0, limit) : TESTIMONIALS;
const track = [...items, ...items];
---

<div
  class="marquee-track overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_5%,black_95%,transparent)]"
>
  <ul class="animate-marquee-slow flex w-max items-stretch gap-6 pr-6">
    {
      track.map((t, i) => (
        <li
          class="w-[20rem] shrink-0 sm:w-[24rem]"
          aria-hidden={i >= items.length ? 'true' : undefined}
        >
          <figure class="flex h-full flex-col rounded-2xl border border-ink-100 bg-white p-7">
            <Icon name="quote" size={24} class="text-accent-200" />

            <blockquote class="mt-4 flex-1">
              <p class="text-base font-semibold leading-snug tracking-[-0.01em] text-ink-900">
                {t.quote}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-ink-500">{t.body}</p>
            </blockquote>

            <figcaption class="mt-6 flex items-center gap-3 border-t border-ink-100 pt-5">
              <span
                aria-hidden="true"
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-50 text-xs font-semibold text-accent-700"
              >
                {initials(t.name ?? t.company)}
              </span>

              <div class="min-w-0 flex-1">
                {t.name ? (
                  <>
                    <p class="truncate text-sm font-semibold text-ink-900">{t.name}</p>
                    <p class="truncate text-xs text-ink-500">
                      {t.role}, {t.company}
                    </p>
                  </>
                ) : (
                  <p class="truncate text-sm font-semibold text-ink-900">{t.company}</p>
                )}
              </div>

              {t.result && (
                <a
                  href={t.result.href}
                  tabindex={i >= items.length ? -1 : undefined}
                  class="group shrink-0 rounded-lg border border-ink-100 px-2.5 py-1.5 text-right transition-colors hover:border-accent-600"
                >
                  <span class="block text-sm font-semibold text-ink-900 transition-colors group-hover:text-accent-600">
                    {t.result.value}
                  </span>
                  <span class="block text-[0.625rem] leading-tight text-ink-400">
                    {t.result.label}
                  </span>
                </a>
              )}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</div>

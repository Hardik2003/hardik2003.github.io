---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { AUDITS } from '../data/audits';
---

<section class="border-t border-ink-100 bg-sand-100 py-20 lg:py-28">
  <div class="container-page">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-accent-200 bg-accent-50 px-3.5 py-1.5 text-xs font-medium text-accent-700"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
        Free · No obligation
      </p>
      <h2 class="heading-2 mt-5 text-balance">
        Start with a free AWS audit
      </h2>
      <p class="lede mt-5 text-pretty">
        Give us read-only access and we will tell you what your AWS account is costing you and
        where it is exposed. You get the full executive report either way - there is no
        obligation to work with us.
      </p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-2">
      {
        AUDITS.map((audit, i) => (
          <div data-reveal data-reveal-delay={i * 90} class="card flex flex-col p-7 lg:p-8">
            <div class="flex items-start justify-between gap-4">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-accent-50 text-accent-600">
                <Icon name={audit.icon} size={21} />
              </span>
              <span class="rounded-md bg-ink-50 px-2.5 py-1 text-xs font-medium text-ink-500">
                Free
              </span>
            </div>

            <h3 class="mt-6 text-xl font-semibold tracking-[-0.015em] text-ink-900">
              {audit.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-500">{audit.summary}</p>

            <dl class="mt-7 grid grid-cols-2 gap-x-5 gap-y-4 border-y border-ink-100 py-6">
              {audit.scope.map((s) => (
                <div class="min-w-0">
                  <dt class="sr-only">{s.label}</dt>
                  <dd>
                    <span class="block text-2xl font-semibold tracking-[-0.025em] text-ink-900">
                      {s.value}
                    </span>
                    <span class="mt-1 block text-xs leading-snug text-ink-400">{s.label}</span>
                  </dd>
                </div>
              ))}
            </dl>

            <ul class="mt-6 flex-1 space-y-3">
              {audit.includes.slice(0, 4).map((item) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-600">
                  <Icon name="check" size={17} class="mt-0.5 shrink-0 text-accent-600" />
                  {item}
                </li>
              ))}
            </ul>

            <a
              href={`/free-audit#${audit.slug}`}
              class="group mt-7 inline-flex items-center gap-1.5 text-sm font-medium text-accent-600"
            >
              What the {audit.shortTitle.toLowerCase()} covers
              <Icon
                name="arrow-right"
                size={15}
                class="transition-transform duration-200 group-hover:translate-x-0.5"
              />
            </a>
          </div>
        ))
      }
    </div>

    <div data-reveal class="mt-12 flex flex-wrap justify-center gap-3">
      <Button href="/free-audit" size="lg">Request your free audit</Button>
      <Button href="/free-audit" variant="secondary" size="lg" icon={false}>
        See what is in the report
      </Button>
    </div>
  </div>
</section>

---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { AUDIT } from '../data/audits';
import { AUDIT_APP_URL } from '../consts';
---

<!--
  The free audit is the primary conversion path, so it gets a tinted
  surface of its own rather than sharing the sand used by ordinary
  sections. Light enough to keep dark text and to stay distinct from the
  deep accent band the testimonials sit on.
-->
<section class="border-y border-accent-100 bg-accent-50 py-20 lg:py-28">
  <div class="container-page">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-accent-200 bg-white px-4 py-2 text-sm font-medium text-accent-700 shadow-[0_1px_2px_rgba(11,27,51,0.04)]"
      >
        <span class="h-2 w-2 rounded-full bg-accent-500"></span>
        Free · No obligation · Read-only
      </p>
      <h2 class="heading-2 mt-5 text-balance">
        Start with a <span class="text-accent-600">free</span> AWS audit
      </h2>
      <p class="lede mt-5 text-pretty">
        Give us read-only access and one scan tells you both what your AWS account is wasting and
        where it is exposed. Your score and your three highest-impact fixes come back in about ten
        minutes, yours to action - there is no obligation to work with us.
      </p>
    </div>

    <!--
      One panel, because there is one scan. The two lenses sit inside it as
      halves of a single report rather than as competing products - which is
      also what stops the page promising three fixes twice over.
    -->
    <div
      data-reveal
      class="mt-14 rounded-2xl border-2 border-accent-200 bg-white p-7 transition duration-300 ease-[var(--ease-out-soft)] hover:border-accent-600 hover:shadow-[0_18px_40px_-24px_rgba(29,78,216,0.35)] lg:p-9"
    >
      <dl class="grid grid-cols-2 gap-x-5 gap-y-4 border-b border-ink-100 pb-6 sm:grid-cols-4">
        {
          AUDIT.scope.map((s) => (
            <div class="min-w-0">
              <dt class="sr-only">{s.label}</dt>
              <dd>
                <span class="block text-2xl font-semibold tracking-[-0.025em] text-ink-900">
                  {s.value}
                </span>
                <span class="mt-1 block text-xs leading-snug text-ink-400">{s.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="grid gap-8 pt-7 lg:grid-cols-2 lg:gap-12">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.14em] text-accent-600">
            Free, the moment the scan finishes
          </p>
          <ul class="mt-4 space-y-3">
            {
              AUDIT.free.map((item) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-600">
                  <Icon name="check" size={17} class="mt-0.5 shrink-0 text-accent-600" />
                  {item}
                </li>
              ))
            }
          </ul>
          <p class="mt-5 border-t border-ink-100 pt-5 text-sm leading-relaxed text-ink-500">
            The full findings register, compliance mapping and 90-day roadmap come in a 30-minute
            walkthrough with the engineer who ran the scan.
          </p>
        </div>

        <div class="space-y-4">
          {
            AUDIT.lenses.map((lens) => (
              <a
                href={`/free-audit#${lens.slug}`}
                class="group block rounded-xl border border-ink-100 p-5 transition-colors hover:border-accent-600"
              >
                <div class="flex items-center gap-3">
                  <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-50 text-accent-600">
                    <Icon name={lens.icon} size={19} />
                  </span>
                  <h3 class="font-semibold tracking-[-0.01em] text-ink-900 transition-colors group-hover:text-accent-600">
                    {lens.title}
                  </h3>
                </div>
                <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink-500">{lens.summary}</p>
                <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-accent-600">
                  What it covers
                  <Icon
                    name="arrow-right"
                    size={15}
                    class="transition-transform duration-200 group-hover:translate-x-0.5"
                  />
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div data-reveal class="mt-12 flex flex-wrap justify-center gap-3">
      <Button href={AUDIT_APP_URL} size="lg">Request your free audit</Button>
      <!-- Stays internal: this one promises the explainer, not the app. -->
      <Button href="/free-audit" variant="secondary" size="lg" icon={false}>
        See what is in the report
      </Button>
    </div>
  </div>
</section>

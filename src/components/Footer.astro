---
import { SITE, CONTACT, FOOTER_NAV } from '../consts';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="bg-ink-950 text-ink-200">
  <div class="container-page py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_2fr]">
      <div>
        <Logo class="h-8 w-auto" invert />
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-ink-300">
          Senior cloud and DevOps engineers for teams on AWS, Azure and GCP. One team for the
          whole platform, not a specialist for each piece.
        </p>

        <address class="mt-7 space-y-3 text-sm not-italic">
          <div class="flex gap-3">
            <Icon name="map-pin" size={18} class="mt-px shrink-0 text-ink-400" />
            <span class="text-ink-300">
              {
                CONTACT.offices.map((office, i) => (
                  <>
                    {office.street && (
                      <>
                        {office.street}
                        <br />
                      </>
                    )}
                    {office.city}
                    {office.postalCode ? ` - ${office.postalCode}` : ''}, {office.region}
                    {i < CONTACT.offices.length - 1 && <br />}
                  </>
                ))
              }
            </span>
          </div>
          <a
            href={`tel:${CONTACT.phoneHref}`}
            class="flex gap-3 py-1 text-ink-300 transition-colors hover:text-white"
          >
            <Icon name="phone" size={18} class="shrink-0 text-ink-400" />
            {CONTACT.phone}
          </a>
          <a
            href={`mailto:${CONTACT.email}`}
            class="flex gap-3 py-1 text-ink-300 transition-colors hover:text-white"
          >
            <Icon name="mail" size={18} class="shrink-0 text-ink-400" />
            {CONTACT.email}
          </a>
        </address>

        <a
          href={CONTACT.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ScionTech on LinkedIn"
          class="mt-7 inline-flex h-10 w-10 items-center justify-center rounded-lg border border-ink-800 text-ink-300 transition-colors hover:border-accent-500 hover:text-white"
        >
          <Icon name="linkedin" size={19} />
        </a>
      </div>

      <div class="grid gap-10 sm:grid-cols-3">
        {
          FOOTER_NAV.map((group) => (
            <div>
              <h2 class="text-xs font-medium uppercase tracking-[0.14em] text-ink-400">
                {group.title}
              </h2>
              <ul class="mt-4 space-y-1">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="inline-block py-1.5 text-sm text-ink-300 transition-colors hover:text-white"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-ink-800/70 pt-7 text-sm text-ink-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.legalName}. All rights reserved.</p>
      <p>Cloud and DevOps engineering - Bengaluru and Ahmedabad, India.</p>
    </div>
  </div>
</footer>

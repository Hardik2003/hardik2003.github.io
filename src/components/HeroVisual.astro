---
/**
 * Stylised pipeline-run panel used as the hero visual. Drawn rather than
 * photographed so it stays sharp at any size, weighs ~4kB, and says
 * "secure delivery pipeline" without relying on stock imagery.
 */
const stages = [
  { name: 'Commit', detail: 'feat/checkout-api', status: 'done' },
  { name: 'Build and test', detail: '248 tests · 1m 12s', status: 'done' },
  { name: 'Security gates', detail: 'SAST · SCA · secrets', status: 'active' },
  { name: 'Deploy to production', detail: 'canary · 10% traffic', status: 'queued' },
];

const gates = [
  { label: 'SAST', value: 'Pass' },
  { label: 'Dependencies', value: 'Pass' },
  { label: 'Secrets', value: 'Pass' },
  { label: 'IaC policy', value: 'Pass' },
];
---

<div
  class="relative overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-[0_28px_70px_-40px_rgba(11,27,51,0.45)]"
  role="img"
  aria-label="An illustration of a secure delivery pipeline: commit, build and test, security gates including SAST, dependency and secret scanning, then a canary deploy to production."
>
  <!-- Window chrome -->
  <div class="flex items-center gap-2 border-b border-ink-100 bg-sand-100 px-5 py-3.5">
    <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
    <p class="ml-2 font-mono text-[0.6875rem] text-ink-400">pipeline · main</p>
    <span
      class="ml-auto inline-flex items-center gap-1.5 rounded-full bg-accent-50 px-2.5 py-1 text-[0.6875rem] font-medium text-accent-700"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
      Running
    </span>
  </div>

  <div class="p-6">
    <!-- Stages -->
    <ol class="space-y-0">
      {
        stages.map((stage, i) => (
          <li class="relative flex gap-4 pb-6 last:pb-0">
            {i < stages.length - 1 && (
              <span
                class:list={[
                  'absolute left-[0.6875rem] top-6 h-full w-px',
                  stage.status === 'done' ? 'bg-accent-200' : 'bg-ink-100',
                ]}
              />
            )}

            <span
              class:list={[
                'relative z-10 mt-0.5 flex h-[1.375rem] w-[1.375rem] shrink-0 items-center justify-center rounded-full border-2',
                stage.status === 'done' && 'border-accent-600 bg-accent-600',
                stage.status === 'active' && 'border-accent-600 bg-white',
                stage.status === 'queued' && 'border-ink-200 bg-white',
              ]}
            >
              {stage.status === 'done' && (
                <svg viewBox="0 0 24 24" class="h-3 w-3 text-white" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m4.5 12.5 5 5 10-11" />
                </svg>
              )}
              {stage.status === 'active' && (
                <span class="h-2 w-2 rounded-full bg-accent-600" />
              )}
            </span>

            <div class="min-w-0 flex-1">
              <p
                class:list={[
                  'text-sm font-medium leading-snug',
                  stage.status === 'queued' ? 'text-ink-400' : 'text-ink-900',
                ]}
              >
                {stage.name}
              </p>
              <p class="mt-0.5 font-mono text-[0.6875rem] text-ink-400">{stage.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Gate results -->
    <div class="mt-2 rounded-xl border border-ink-100 bg-sand-50 p-4">
      <p class="text-[0.6875rem] font-medium uppercase tracking-[0.12em] text-ink-400">
        Security gates
      </p>
      <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2.5">
        {
          gates.map((gate) => (
            <div class="flex items-center justify-between gap-2">
              <dt class="truncate text-xs text-ink-600">{gate.label}</dt>
              <dd class="flex shrink-0 items-center gap-1 text-xs font-medium text-accent-700">
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m4.5 12.5 5 5 10-11" />
                </svg>
                {gate.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</div>

---
/**
 * Platform-overview panel used as the hero visual. Drawn rather than
 * photographed so it stays sharp at any size and weighs a few kB.
 *
 * The four metrics deliberately span the whole offering - cost, delivery,
 * reliability and security - rather than leading on any one of them.
 */
const metrics = [
  { label: 'Monthly cloud spend', value: '$18,240', delta: '−31%', good: true, icon: 'wallet' },
  { label: 'Deploys this week', value: '47', delta: '+12', good: true, icon: 'git-branch' },
  { label: 'Availability', value: '99.98%', delta: 'SLO met', good: true, icon: 'activity' },
  { label: 'Open findings', value: '3', delta: '−28', good: true, icon: 'cloud-lock' },
];

const workloads = [
  { name: 'api-gateway', env: 'EKS · eu-west-1', state: 'Healthy' },
  { name: 'checkout-worker', env: 'Lambda · 4.2M/day', state: 'Healthy' },
  { name: 'analytics-etl', env: 'Fargate · Spot', state: 'Scaling' },
];

import Icon from './Icon.astro';
---

<div
  class="relative overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-[0_28px_70px_-40px_rgba(11,27,51,0.45)]"
  role="img"
  aria-label="An illustration of a cloud platform overview: monthly spend down 31 percent, 47 deploys this week, 99.98 percent availability, three open security findings, and a list of healthy workloads running on EKS, Lambda and Fargate."
>
  <div class="flex items-center gap-2 border-b border-ink-100 bg-sand-100 px-5 py-3.5">
    <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
    <p class="ml-2 font-mono text-[0.6875rem] text-ink-400">platform · production</p>
    <span
      class="ml-auto inline-flex items-center gap-1.5 rounded-full bg-accent-50 px-2.5 py-1 text-[0.6875rem] font-medium text-accent-700"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
      Live
    </span>
  </div>

  <div class="p-6">
    <dl class="grid grid-cols-2 gap-3">
      {
        metrics.map((m) => (
          <div class="rounded-xl border border-ink-100 p-3.5">
            <dt class="flex items-center gap-1.5 text-[0.6875rem] leading-snug text-ink-400">
              <Icon name={m.icon} size={13} class="shrink-0" />
              {m.label}
            </dt>
            <dd class="mt-1.5 flex items-baseline gap-1.5">
              <span class="text-lg font-semibold tracking-[-0.02em] text-ink-900">{m.value}</span>
              <span class="text-[0.6875rem] font-medium text-accent-700">{m.delta}</span>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-4 rounded-xl border border-ink-100 bg-sand-50 p-4">
      <p class="text-[0.6875rem] font-medium uppercase tracking-[0.12em] text-ink-400">
        Workloads
      </p>
      <ul class="mt-3 space-y-2.5">
        {
          workloads.map((w) => (
            <li class="flex items-center gap-3">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500" />
              <span class="min-w-0 flex-1 truncate font-mono text-[0.6875rem] text-ink-700">
                {w.name}
              </span>
              <span class="hidden shrink-0 font-mono text-[0.625rem] text-ink-400 sm:block">
                {w.env}
              </span>
              <span class="shrink-0 text-[0.6875rem] font-medium text-ink-500">{w.state}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

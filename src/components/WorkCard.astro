---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'work'>;
  index?: number;
  featured?: boolean;
}

const { item, index, featured = false } = Astro.props;
const { title, sector, summary, image, tags, results, client } = item.data;
---

<article data-reveal data-reveal-delay={(index ?? 0) * 70} class="group">
  <a href={`/work/${item.id}`} class="block">
    <div class="relative overflow-hidden rounded-2xl bg-ink-100">
      <Image
        src={image}
        alt={`${title} — ${sector} case study`}
        widths={featured ? [640, 960, 1280] : [400, 640, 900]}
        sizes={featured
          ? '(min-width: 1024px) 50vw, 100vw'
          : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
        class:list={[
          'w-full object-cover transition-transform duration-700 ease-[var(--ease-out-soft)] group-hover:scale-[1.04]',
          featured ? 'aspect-[16/10]' : 'aspect-[4/3]',
        ]}
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-ink-950/70 via-ink-950/5 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
      >
      </div>
    </div>

    <div class="mt-5">
      <div class="flex items-center gap-2.5 text-xs font-medium uppercase tracking-[0.1em]">
        <span class="text-accent-600">{sector}</span>
        {client && <span class="text-ink-300">·</span>}
        {client && <span class="text-ink-400">{client}</span>}
      </div>

      <h3
        class="mt-2.5 text-xl font-semibold leading-snug tracking-[-0.015em] text-ink-900 transition-colors group-hover:text-accent-600"
      >
        {title}
      </h3>
      <p class="mt-3 text-sm leading-relaxed text-ink-500">{summary}</p>

      {
        results.length > 0 && (
          <dl class="mt-5 grid grid-cols-2 gap-x-5 gap-y-4 border-t border-ink-100 pt-5">
            {results.slice(0, 2).map((r) => (
              <div class="min-w-0">
                <dt class="sr-only">{r.label}</dt>
                <dd>
                  <span class="block text-xl font-semibold tracking-[-0.02em] text-ink-900">
                    {r.value}
                  </span>
                  <span class="mt-0.5 block text-xs leading-snug text-ink-400">{r.label}</span>
                </dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="rounded-md bg-ink-50 px-2.5 py-1 text-xs font-medium text-ink-500">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </a>
</article>

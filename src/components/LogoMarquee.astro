---
import { Image } from 'astro:assets';
import { CLIENTS } from '../data/clients';

interface Props {
  label?: string;
}

const { label = 'Trusted by teams shipping in production' } = Astro.props;
const track = [...CLIENTS, ...CLIENTS];
---

<section class="border-y border-ink-100 bg-white py-10" aria-label="Our clients">
  <p class="container-page text-center text-xs font-medium uppercase tracking-[0.14em] text-ink-400">
    {label}
  </p>

  <div
    class="mt-7 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]"
  >
    <ul class="animate-marquee flex w-max items-center gap-14 pr-14">
      {
        track.map((client, i) => (
          <li class="shrink-0">
            <Image
              src={client.logo}
              alt={i < CLIENTS.length ? client.name : ''}
              aria-hidden={i >= CLIENTS.length}
              width={132}
              height={44}
              densities={[1, 2]}
              loading="lazy"
              class="h-11 w-auto object-contain opacity-55 grayscale transition duration-300 hover:opacity-100 hover:grayscale-0"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

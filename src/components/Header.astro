---
import { NAV } from '../consts';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-all duration-300 ease-[var(--ease-out-soft)]"
>
  <div class="container-page">
    <div class="flex h-[4.5rem] items-center justify-between gap-6">
      <a href="/" class="shrink-0" aria-label="ScionTech home">
        <Logo class="h-8 w-auto" />
      </a>

      <nav aria-label="Primary" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'relative rounded-lg px-3.5 py-2 text-sm font-medium transition-colors duration-200',
                    isActive(item.href)
                      ? 'text-ink-900'
                      : 'text-ink-500 hover:text-ink-900',
                  ]}
                >
                  {item.label}
                  {isActive(item.href) && (
                    <span class="absolute inset-x-3.5 -bottom-px h-px bg-accent-600" />
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="hidden items-center gap-3 lg:flex">
        <a
          href="/free-audit"
          class="inline-flex items-center gap-2 rounded-lg border border-accent-200 bg-accent-50 px-3.5 py-2 text-sm font-medium text-accent-700 transition-colors hover:border-accent-600 hover:bg-accent-100"
        >
          <span
            class="rounded bg-accent-600 px-1.5 py-0.5 text-[0.625rem] font-semibold uppercase tracking-[0.06em] text-white"
          >
            Free
          </span>
          AWS audit
        </a>
        <a
          href="/contact"
          class="group inline-flex items-center gap-1.5 rounded-lg bg-ink-900 px-4 py-2.5 text-sm font-medium text-white transition-all duration-200 hover:bg-accent-600"
        >
          Consult our experts
          <Icon
            name="arrow-right"
            size={16}
            class="transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </a>
      </div>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="-mr-2 inline-flex h-10 w-10 items-center justify-center rounded-lg text-ink-800 transition-colors hover:bg-ink-50 lg:hidden"
      >
        <Icon name="menu" size={22} id="menu-icon-open" />
        <Icon name="x" size={22} class="hidden" id="menu-icon-close" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    hidden
    class="border-t border-ink-100 bg-white/98 backdrop-blur lg:hidden"
  >
    <nav aria-label="Mobile" class="container-page py-5">
      <ul class="space-y-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink-800 transition-colors hover:bg-ink-50"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/free-audit"
        class="mt-4 flex items-center justify-center gap-2 rounded-lg border border-accent-200 bg-accent-50 px-4 py-3 text-sm font-medium text-accent-700"
      >
        <span
          class="rounded bg-accent-600 px-1.5 py-0.5 text-[0.625rem] font-semibold uppercase tracking-[0.06em] text-white"
        >
          Free
        </span>
        AWS audit
      </a>
      <a
        href="/contact"
        class="mt-2.5 flex items-center justify-center gap-2 rounded-lg bg-ink-900 px-4 py-3 text-sm font-medium text-white"
      >
        Consult our experts
        <Icon name="arrow-right" size={16} />
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconOpen = document.getElementById('menu-icon-open')!;
  const iconClose = document.getElementById('menu-icon-close')!;

  const solidClasses = ['bg-white/90', 'backdrop-blur-md', 'border-ink-100'];

  const applyScrollState = () => {
    const scrolled = window.scrollY > 8;
    header.classList.toggle('border-transparent', !scrolled);
    solidClasses.forEach((c) => header.classList.toggle(c, scrolled));
  };

  applyScrollState();
  window.addEventListener('scroll', applyScrollState, { passive: true });

  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    menu.hidden = open;
    iconOpen.classList.toggle('hidden', !open);
    iconClose.classList.toggle('hidden', open);
    // Keep the bar readable while the panel is open over page content.
    if (!open) solidClasses.forEach((c) => header.classList.add(c));
    else applyScrollState();
  });
</script>

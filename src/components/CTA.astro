---
import Button from './Button.astro';
import { CONTACT } from '../consts';

interface Props {
  title?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
}

const {
  title = "Let's pressure-test your pipeline",
  body = 'A free 30-minute assessment with a senior engineer. We look at your delivery path, flag the risks that matter, and tell you what we would fix first — whether or not you work with us.',
  primaryLabel = 'Book your assessment',
  primaryHref = '/contact',
} = Astro.props;
---

<section class="bg-ink-950">
  <div class="container-page py-20 lg:py-28">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <h2 class="heading-2 !text-white">{title}</h2>
      <p class="lede mt-5 !text-ink-300">{body}</p>

      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href={primaryHref} variant="invert" size="lg">{primaryLabel}</Button>
        <a
          href={`mailto:${CONTACT.email}`}
          class="rounded-lg px-6 py-3.5 text-[0.9375rem] font-medium text-ink-200 transition-colors hover:text-white"
        >
          Or email {CONTACT.email}
        </a>
      </div>
    </div>
  </div>
</section>

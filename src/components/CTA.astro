---
import Button from './Button.astro';
import { CONTACT } from '../consts';

interface Props {
  title?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  /** Off for CTAs that are not the free audit offer. */
  badge?: boolean;
}

const {
  title = 'Start with a free AWS audit',
  body = 'Give us read-only access and we will tell you what your account is costing you and where it is exposed. You keep the full executive report whether or not you go on to work with us.',
  primaryLabel = 'Request your free audit',
  primaryHref = '/free-audit',
  badge = true,
} = Astro.props;
---

<section class="bg-ink-950">
  <div class="container-page py-20 lg:py-28">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      {
        badge && (
          <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-accent-500/40 bg-accent-600/15 px-4 py-2 text-sm font-medium text-accent-200">
            <span class="rounded bg-accent-600 px-1.5 py-0.5 text-[0.625rem] font-semibold uppercase tracking-[0.06em] text-white">
              Free
            </span>
            No obligation, report is yours to keep
          </p>
        )
      }
      <h2 class="heading-2 !text-white">{title}</h2>
      <p class="lede mt-5 !text-ink-300">{body}</p>

      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href={primaryHref} variant="invert" size="lg">{primaryLabel}</Button>
        <a
          href={`mailto:${CONTACT.email}`}
          class="rounded-lg px-6 py-3.5 text-[0.9375rem] font-medium text-ink-200 transition-colors hover:text-white"
        >
          Or email {CONTACT.email}
        </a>
      </div>
    </div>
  </div>
</section>

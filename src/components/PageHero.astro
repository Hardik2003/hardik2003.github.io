---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<section class="border-b border-ink-100 bg-sand-100">
  <div class="container-page py-16 lg:py-24">
    <div class="max-w-3xl">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="heading-1 mt-4">{title}</h1>
      {lede && <p class="lede mt-6 max-w-2xl">{lede}</p>}
    </div>
  </div>
</section>

---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: 'left' | 'center';
  invert?: boolean;
  class?: string;
}

const { eyebrow, title, lede, align = 'left', invert = false, class: className = '' } = Astro.props;
---

<div
  data-reveal
  class:list={[
    'max-w-2xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
>
  {eyebrow && <p class={invert ? 'eyebrow-invert' : 'eyebrow'}>{eyebrow}</p>}
  <h2 class:list={['heading-2', eyebrow && 'mt-3', invert && '!text-white']}>
    {title}
  </h2>
  {
    lede && (
      <p class:list={['lede mt-5', invert && '!text-ink-300']}>
        {lede}
      </p>
    )
  }
</div>

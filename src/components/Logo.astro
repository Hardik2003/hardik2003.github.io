---
interface Props {
  class?: string;
  /** Renders light-on-dark for the footer and dark bands. */
  invert?: boolean;
}

const { class: className = '', invert = false } = Astro.props;

const markBg = invert ? '#ffffff' : '#0b1b33';
const markFg = invert ? '#0b1b33' : '#ffffff';
const wordFill = invert ? '#ffffff' : '#0b1b33';
---

<svg
  class={className}
  viewBox="0 0 168 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="ScionTech"
>
  <rect width="32" height="32" rx="8" fill={markBg}></rect>
  <path
    d="M21.2 11.4c-1.1-1.4-2.9-2.3-5-2.3-3.2 0-5.4 1.7-5.4 4.2 0 2.3 1.6 3.5 4.7 4.1l1.6.3c1.6.3 2.3.8 2.3 1.7 0 1.1-1.1 1.8-2.8 1.8-1.6 0-2.9-.6-3.8-1.8"
    stroke={markFg}
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="22.4" cy="21.6" r="1.8" fill="#3b6df6"></circle>
  <text
    x="42"
    y="22.2"
    fill={wordFill}
    font-family="Inter Variable, Inter, system-ui, sans-serif"
    font-size="18"
    font-weight="600"
    letter-spacing="-0.5">Scion<tspan font-weight="400">Tech</tspan></text
  >
</svg>

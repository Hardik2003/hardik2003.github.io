---
import Testimonials from './Testimonials.astro';
import { TESTIMONIALS } from '../data/testimonials';
import { CLIENTS } from '../data/clients';

/**
 * Social proof gets the one saturated band on the site.
 *
 * accent-600 rather than the brighter accent-500: at full-bleed section
 * scale the mid blue overpowers the restrained palette, and neither the
 * accent eyebrow nor the near-black heading has usable contrast on it.
 * The deeper blue carries white text properly and still reads as brand.
 *
 * It is also deliberately not the ink-950 used by the stats and closing
 * CTA bands, so the page alternates between three surfaces rather than
 * repeating the same dark one.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  limit?: number;
  class?: string;
}

/**
 * Framing the count turns a short list into a deliberate selection rather
 * than something that looks unfinished. Both numbers are read from the
 * data, so they stay right as quotes are added.
 */
const shown = Astro.props.limit ?? TESTIMONIALS.length;
const defaultLede = `${shown} of the ${CLIENTS.length} teams we work with, in their own words.`;

const {
  eyebrow = 'Client journeys',
  title = 'What our clients say',
  lede = defaultLede,
  limit,
  class: className = '',
} = Astro.props;
---

<section class:list={['bg-accent-600', className]}>
  <div class="container-page py-20 lg:py-28">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-[0.14em] text-accent-100">
        {eyebrow}
      </p>
      <h2 class="heading-2 mt-3 !text-white">{title}</h2>
      {lede && <p class="mt-5 text-lg leading-relaxed text-accent-100">{lede}</p>}
    </div>

    <div class="mt-14">
      <Testimonials limit={limit} />
    </div>
  </div>
</section>

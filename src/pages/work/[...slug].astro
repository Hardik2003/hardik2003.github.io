---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import WorkCard from '../../components/WorkCard.astro';
import CTA from '../../components/CTA.astro';
import { SITE } from '../../consts';

export const getStaticPaths: GetStaticPaths = async () => {
  const work = await getCollection('work');
  return work.map((item) => ({ params: { slug: item.id }, props: { item } }));
};

type Props = { item: CollectionEntry<'work'> };

const { item } = Astro.props;
const { Content } = await render(item);
const { title, client, sector, summary, image, results, stack, tags, date, seoTitle, seoDescription } =
  item.data;

const others = (await getCollection('work'))
  .filter((w) => w.id !== item.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary,
  url: `${SITE.url}/work/${item.id}`,
  datePublished: date.toISOString(),
  author: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
  about: sector,
  image: new URL(image.src, SITE.url).href,
};
---

<Base
  title={seoTitle ?? title}
  description={seoDescription ?? summary}
  type="article"
  publishedTime={date}
  breadcrumbs={[
    { name: 'Work', href: '/work' },
    { name: title, href: `/work/${item.id}` },
  ]}
  schema={[schema]}
>
  <article>
    <header class="border-b border-ink-100 bg-sand-100">
      <div class="container-page py-16 lg:py-20">
        <nav aria-label="Breadcrumb" class="mb-8">
          <ol class="flex flex-wrap items-center gap-2 text-sm text-ink-400">
            <li><a href="/" class="transition-colors hover:text-ink-900">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/work" class="transition-colors hover:text-ink-900">Work</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-ink-600" aria-current="page">{sector}</li>
          </ol>
        </nav>

        <div class="max-w-3xl">
          <div class="flex items-center gap-2.5 text-xs font-medium uppercase tracking-[0.1em]">
            <span class="text-accent-600">{sector}</span>
            {client && <span class="text-ink-300">·</span>}
            {client && <span class="text-ink-400">{client}</span>}
          </div>
          <h1 class="heading-1 mt-4 text-balance">{title}</h1>
          <p class="lede mt-6 text-pretty">{summary}</p>
        </div>
      </div>
    </header>

    <div class="bg-white">
      <div class="container-page -mt-px">
        <div class="overflow-hidden rounded-2xl border border-ink-100 lg:-mt-10">
          <Image
            src={image}
            alt={`${title} - ${sector}`}
            widths={[720, 1080, 1440]}
            sizes="(min-width: 1200px) 1140px, 100vw"
            loading="eager"
            class="aspect-[16/9] w-full object-cover"
          />
        </div>
      </div>

      {
        results.length > 0 && (
          <div class="container-page mt-14">
            <dl class="grid gap-8 border-y border-ink-100 py-10 sm:grid-cols-3">
              {results.map((r) => (
                <div>
                  <dt class="sr-only">{r.label}</dt>
                  <dd>
                    <span class="block text-4xl font-semibold tracking-[-0.03em] text-ink-900">
                      {r.value}
                    </span>
                    <span class="mt-2 block text-sm text-ink-500">{r.label}</span>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }

      <div class="container-page py-14 lg:py-20">
        <div class="grid gap-14 lg:grid-cols-[1fr_18rem] lg:gap-20">
          <div
            class="prose prose-lg max-w-none prose-headings:font-semibold prose-headings:tracking-[-0.02em] prose-headings:text-ink-900 prose-p:text-ink-600 prose-p:leading-relaxed prose-a:text-accent-600 prose-strong:text-ink-900"
          >
            <Content />
          </div>

          <aside class="space-y-8 lg:sticky lg:top-28 lg:self-start">
            {
              stack.length > 0 && (
                <div>
                  <h2 class="text-xs font-medium uppercase tracking-[0.14em] text-ink-400">
                    Technology
                  </h2>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {stack.map((s) => (
                      <li class="rounded-md border border-ink-100 bg-white px-2.5 py-1.5 text-xs font-medium text-ink-600">
                        {s}
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            {
              tags.length > 0 && (
                <div>
                  <h2 class="text-xs font-medium uppercase tracking-[0.14em] text-ink-400">
                    Focus
                  </h2>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {tags.map((t) => (
                      <li class="rounded-md bg-ink-50 px-2.5 py-1.5 text-xs font-medium text-ink-500">
                        {t}
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            <a
              href="/contact"
              class="flex items-center justify-center gap-2 rounded-lg bg-ink-900 px-4 py-3 text-sm font-medium text-white transition-colors hover:bg-accent-600"
            >
              Start a similar project
              <Icon name="arrow-right" size={16} />
            </a>
          </aside>
        </div>
      </div>
    </div>
  </article>

  <section class="border-t border-ink-100 bg-sand-100 py-16 lg:py-20">
    <div class="container-page">
      <h2 class="heading-3">More case studies</h2>
      <div class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((w, i) => <WorkCard item={w} index={i} />)}
      </div>
    </div>
  </section>

  <CTA />
</Base>

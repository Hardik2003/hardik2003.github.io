---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import CTA from '../../components/CTA.astro';
import { SITE } from '../../consts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, category, author, image, imageAlt, readingTime } =
  post.data;

const related = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const toc = headings.filter((h) => h.depth === 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: `${SITE.url}/blog/${post.id}`,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: author },
  publisher: { '@id': `${SITE.url}/#organization` },
  image: new URL(image.src, SITE.url).href,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE.url}/blog/${post.id}` },
  articleSection: category,
  wordCount: undefined,
};
---

<Base
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  author={author}
  breadcrumbs={[
    { name: 'Blog', href: '/blog' },
    { name: title, href: `/blog/${post.id}` },
  ]}
  schema={[schema]}
>
  <article>
    <header class="border-b border-ink-100 bg-sand-100">
      <div class="container-page py-16 lg:py-20">
        <nav aria-label="Breadcrumb" class="mb-8">
          <ol class="flex flex-wrap items-center gap-2 text-sm text-ink-400">
            <li><a href="/" class="transition-colors hover:text-ink-900">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/blog" class="transition-colors hover:text-ink-900">Blog</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-ink-600" aria-current="page">{category}</li>
          </ol>
        </nav>

        <div class="max-w-3xl">
          <div class="flex flex-wrap items-center gap-3 text-sm text-ink-400">
            <span class="text-xs font-medium uppercase tracking-[0.1em] text-accent-600">
              {category}
            </span>
            <span aria-hidden="true">·</span>
            <FormattedDate date={pubDate} />
            <span aria-hidden="true">·</span>
            <span>{readingTime} min read</span>
          </div>

          <h1 class="heading-1 mt-4 text-balance">{title}</h1>
          <p class="lede mt-6 text-pretty">{description}</p>

          <p class="mt-7 text-sm text-ink-500">
            By <span class="font-medium text-ink-900">{author}</span>
          </p>
        </div>
      </div>
    </header>

    <div class="bg-white">
      <div class="container-page">
        <div class="overflow-hidden rounded-2xl border border-ink-100 lg:-mt-10">
          <Image
            src={image}
            alt={imageAlt}
            widths={[720, 1080, 1440]}
            sizes="(min-width: 1200px) 1140px, 100vw"
            loading="eager"
            class="aspect-[16/9] w-full object-cover"
          />
        </div>
      </div>

      <div class="container-page py-14 lg:py-20">
        <div class="grid gap-14 lg:grid-cols-[1fr_16rem] lg:gap-20">
          <div
            class="prose prose-lg max-w-none prose-headings:font-semibold prose-headings:tracking-[-0.02em] prose-headings:text-ink-900 prose-h2:mt-14 prose-h2:scroll-mt-28 prose-h2:text-[1.75rem] prose-h3:mt-10 prose-h3:text-xl prose-p:text-ink-600 prose-p:leading-relaxed prose-a:text-accent-600 prose-a:no-underline hover:prose-a:underline prose-strong:text-ink-900 prose-li:text-ink-600 prose-blockquote:border-l-accent-600 prose-blockquote:not-italic prose-blockquote:text-ink-600 prose-table:text-sm prose-th:text-ink-900 prose-td:text-ink-600 prose-img:rounded-xl"
          >
            <Content />
          </div>

          {
            toc.length > 2 && (
              <aside class="hidden lg:sticky lg:top-28 lg:block lg:self-start">
                <h2 class="text-xs font-medium uppercase tracking-[0.14em] text-ink-400">
                  On this page
                </h2>
                <ul class="mt-5 space-y-3 border-l border-ink-100">
                  {toc.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        class="-ml-px block border-l border-transparent pl-4 text-sm leading-snug text-ink-500 transition-colors hover:border-accent-600 hover:text-ink-900"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </aside>
            )
          }
        </div>
      </div>
    </div>
  </article>

  <section class="border-t border-ink-100 bg-sand-100 py-16 lg:py-20">
    <div class="container-page">
      <h2 class="heading-3">Keep reading</h2>
      <div class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p, i) => <BlogCard post={p} index={i} />)}
      </div>
    </div>
  </section>

  <CTA />
</Base>

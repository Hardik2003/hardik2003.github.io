---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { AUDIT, AUDIT_PRINCIPLES } from '../data/audits';
import { SITE, AUDIT_APP_URL } from '../consts';

/**
 * Mirrors the three steps on the audit app itself. Durations included
 * because the speed is the offer - the previous "about a week end to end"
 * undersold a scan that returns a score in minutes.
 */
const steps = [
  {
    duration: '~60 seconds',
    title: 'Connect in one click',
    body: 'You deploy a CloudFormation stack in your own account. It creates a read-only IAM role scoped by an external ID unique to you, carrying two AWS-managed policies - SecurityAudit and ViewOnlyAccess, nothing bespoke. You never send us a credential, and deleting the stack ends our access immediately.',
  },
  {
    duration: '3-15 minutes',
    title: 'We scan, read-only',
    body: '637 checks across every region with active resources, covering IAM, network exposure, encryption, logging, threat detection and workload configuration - plus a sweep for idle and abandoned resources you are still paying for.',
  },
  {
    duration: 'Immediate',
    title: 'You get your score',
    body: 'Your risk score, three fully worked fixes, and what the account is wasting - each item priced from AWS published rates. The complete findings register and the 90-day roadmap come in a 30-minute walkthrough with the engineer who ran the scan.',
  },
];

const severityStyles: Record<string, string> = {
  Critical: 'bg-red-50 text-red-700',
  High: 'bg-amber-50 text-amber-700',
  Medium: 'bg-ink-50 text-ink-600',
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Free AWS security and cost optimisation audit',
  description:
    'A no-obligation AWS audit covering 637 security checks mapped to SOC 2, ISO 27001, PCI DSS, HIPAA, GDPR, CIS and NIST, plus a cost optimisation review that identifies confirmed recoverable waste.',
  url: `${SITE.url}/free-audit`,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: ['US', 'GB', 'EU', 'AE', 'AU', 'IN'],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description:
      'Complimentary AWS security and cost audit. Risk score, severity breakdown and three fully worked fixes in about ten minutes, with the full findings register and 90-day roadmap in a 30-minute walkthrough.',
  },
};
---

<Base
  title="Free AWS security and cost audit"
  description="A free, read-only AWS audit: 637 checks mapped to SOC 2, ISO 27001, PCI DSS, HIPAA, GDPR, CIS and NIST. Your risk score and three worked fixes in about ten minutes."
  breadcrumbs={[{ name: 'Free audit', href: '/free-audit' }]}
  schema={[schema]}
>
  <!-- Hero -->
  <section class="border-b border-ink-100 bg-sand-100">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-3xl">
        <p
          class="inline-flex items-center gap-2 rounded-full border border-accent-200 bg-white px-3.5 py-1.5 text-xs font-medium text-accent-700"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
          Free · No obligation · Read-only
        </p>
        <h1 class="heading-1 mt-6 text-balance">
          Find out what your AWS account is really costing you
        </h1>
        <p class="lede mt-6 text-pretty">
          One read-only scan tells you both where you are exposed and what the account is wasting -
          usually the same resources. Your score and your three highest-impact fixes land in about
          ten minutes, yours to action whether or not you go on to work with us.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href={AUDIT_APP_URL} size="lg">Request your free audit</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- One scan: scope, and the free / walkthrough split -->
  <section class="bg-white py-20 lg:py-28">
    <div class="container-page">
      <div class="grid gap-14 lg:grid-cols-[1fr_22rem] lg:gap-20">
        <div>
          <p data-reveal class="eyebrow">The scan</p>
          <h2 data-reveal class="heading-2 mt-5">{AUDIT.title}</h2>
          <p data-reveal class="lede mt-5 max-w-2xl">{AUDIT.summary}</p>

          <dl
            data-reveal
            class="mt-10 grid grid-cols-2 gap-x-6 gap-y-6 border-y border-ink-100 py-8 sm:grid-cols-4"
          >
            {
              AUDIT.scope.map((s) => (
                <div class="min-w-0">
                  <dt class="sr-only">{s.label}</dt>
                  <dd>
                    <span class="block text-3xl font-semibold tracking-[-0.03em] text-ink-900">
                      {s.value}
                    </span>
                    <span class="mt-1.5 block text-xs leading-snug text-ink-400">{s.label}</span>
                  </dd>
                </div>
              ))
            }
          </dl>

          <!-- Jump links keep both halves reachable from the top of the page -->
          <ul data-reveal class="mt-10 flex flex-wrap gap-3">
            {
              AUDIT.lenses.map((lens) => (
                <li>
                  <a
                    href={`#${lens.slug}`}
                    class="group inline-flex items-center gap-2 rounded-lg border border-ink-200 bg-white px-4 py-2.5 text-sm font-medium text-ink-900 transition-colors hover:border-accent-600 hover:text-accent-600"
                  >
                    <Icon name={lens.icon} size={17} class="text-accent-600" />
                    {lens.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <aside data-reveal class="lg:sticky lg:top-28 lg:self-start">
          <div class="card p-7">
            <h3 class="text-xs font-medium uppercase tracking-[0.14em] text-accent-600">
              Free, the moment the scan finishes
            </h3>
            <ul class="mt-5 space-y-3.5">
              {
                AUDIT.free.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-600">
                    <Icon name="check" size={17} class="mt-0.5 shrink-0 text-accent-600" />
                    {item}
                  </li>
                ))
              }
            </ul>

            <h3
              class="mt-8 border-t border-ink-100 pt-7 text-xs font-medium uppercase tracking-[0.14em] text-ink-400"
            >
              In the 30-minute walkthrough
            </h3>
            <ul class="mt-5 space-y-3.5">
              {
                AUDIT.walkthrough.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-500">
                    <Icon name="arrow-right" size={17} class="mt-0.5 shrink-0 text-ink-300" />
                    {item}
                  </li>
                ))
              }
            </ul>

            <a
              href={AUDIT_APP_URL}
              class="mt-7 flex items-center justify-center gap-2 rounded-lg bg-ink-900 px-4 py-3 text-sm font-medium text-white transition-colors hover:bg-accent-600"
            >
              Request your free audit
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!--
    The two lenses. Sections of one report, not separate products - but the
    #security and #cost anchors are kept, because inbound links and rankings
    already point at them.
  -->
  {
    AUDIT.lenses.map((lens, index) => (
      <section
        id={lens.slug}
        class:list={[
          'scroll-mt-24 py-20 lg:py-28',
          index % 2 === 0 ? 'border-y border-ink-100 bg-sand-100' : 'bg-white',
        ]}
      >
        <div class="container-page">
          <div class="max-w-3xl">
            <div data-reveal class="flex items-center gap-3">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-accent-50 text-accent-600">
                <Icon name={lens.icon} size={21} />
              </span>
              <p class="eyebrow">{lens.eyebrow}</p>
            </div>

            <h2 data-reveal class="heading-2 mt-5">
              {lens.title}
            </h2>
            <p data-reveal class="lede mt-5">
              {lens.summary}
            </p>
          </div>

          <ul data-reveal class="mt-10 grid gap-3 lg:grid-cols-2">
            {lens.sampleFindings.map((f) => (
              <li class="flex items-start gap-3.5 rounded-xl border border-ink-100 bg-white p-4">
                <span
                  class:list={[
                    'mt-0.5 shrink-0 rounded-md px-2 py-1 text-[0.6875rem] font-medium uppercase tracking-[0.06em]',
                    severityStyles[f.severity],
                  ]}
                >
                  {f.severity}
                </span>
                <span class="text-sm leading-relaxed text-ink-600">{f.text}</span>
              </li>
            ))}
          </ul>

          <p
            data-reveal
            class="mt-7 max-w-3xl border-l-2 border-accent-600 bg-white py-1 pl-5 text-sm leading-relaxed text-ink-600"
          >
            {lens.deliverable}
          </p>
        </div>
      </section>
    ))
  }

  <!-- How it works -->
  <section class="bg-white py-20 lg:py-28">
    <div class="container-page">
      <SectionHeading
        eyebrow="How it works"
        title="Three steps, about ten minutes end to end"
        lede="Nothing installed, nothing changed, and no commercial conversation before your score is in front of you."
      />

      <ol class="mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          steps.map((step, i) => (
            <li data-reveal data-reveal-delay={i * 70} class="relative">
              <div class="flex items-baseline justify-between gap-3">
                <span class="font-mono text-xs tabular-nums text-accent-600">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-xs font-medium text-ink-400">{step.duration}</span>
              </div>
              <span class="mt-4 block h-px w-full bg-ink-100" />
              <h3 class="mt-5 text-lg font-semibold tracking-[-0.01em] text-ink-900">
                {step.title}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-ink-500">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Principles -->
  <section class="border-t border-ink-100 bg-sand-100 py-20 lg:py-28">
    <div class="container-page">
      <SectionHeading
        eyebrow="How we work"
        title="What you can hold us to"
        align="center"
      />

      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          AUDIT_PRINCIPLES.map((p, i) => (
            <div data-reveal data-reveal-delay={i * 70} class="card p-7">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-accent-50 text-accent-600">
                <Icon name={p.icon} size={21} />
              </span>
              <h3 class="mt-6 text-base font-semibold tracking-[-0.01em] text-ink-900">
                {p.title}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-ink-500">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <LogoMarquee label="Teams who have already had one" />

  <!-- Closing CTA -->
  <section class="bg-ink-950">
    <div class="container-page py-20 lg:py-28">
      <div data-reveal class="mx-auto max-w-2xl text-center">
        <h2 class="heading-2 !text-white">One scan, no charge</h2>
        <p class="lede mt-5 !text-ink-300">
          Read-only access, your score and three worked fixes in about ten minutes, then a
          30-minute walkthrough with the engineer who ran it. Nothing else attached.
        </p>
        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <Button href={AUDIT_APP_URL} variant="invert" size="lg">Request your free audit</Button>
        </div>
      </div>
    </div>
  </section>
</Base>

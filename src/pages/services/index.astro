---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import CTA from '../../components/CTA.astro';
import { SITE } from '../../consts';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Cloud and DevOps services',
  description:
    'The full range of ScionTech cloud and DevOps services - migration, architecture, cost optimisation, CI/CD, Kubernetes, serverless, observability, managed DevOps and security.',
  url: `${SITE.url}/services`,
  hasPart: services.map((s) => ({
    '@type': 'Service',
    name: s.data.title,
    description: s.data.summary,
    url: `${SITE.url}/services/${s.id}`,
    provider: { '@id': `${SITE.url}/#organization` },
  })),
};
---

<Base
  title="Cloud and DevOps services on AWS and Azure"
  description="Eleven cloud and DevOps practices - migration and architecture, AWS cost optimisation, CI/CD, Kubernetes, serverless, infrastructure as code, observability, managed DevOps and cloud security."
  breadcrumbs={[{ name: 'Services', href: '/services' }]}
  schema={[schema]}
>
  <PageHero
    eyebrow="Services"
    title="The whole platform, one team"
    lede="From the architecture your workloads run on to what it costs you each month. Engagements are scoped to what you actually need, and most clients start with one practice rather than all eleven."
  />

  <section class="bg-white py-16 lg:py-24">
    <div class="container-page">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service, i) => <ServiceCard service={service} index={i} />)}
      </div>
    </div>
  </section>

  <LogoMarquee label="Our valued clients" />
  <CTA />
</Base>

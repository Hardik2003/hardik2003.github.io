---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroVisual from '../components/HeroVisual.astro';
import AuditOffer from '../components/AuditOffer.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import WorkCard from '../components/WorkCard.astro';
import BlogCard from '../components/BlogCard.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import Stats from '../components/Stats.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { SITE, AUDIT_APP_URL } from '../consts';

const services = (await getCollection('services'))
  .filter((s) => s.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'ScionTech services',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.data.title,
      description: s.data.summary,
      url: `${SITE.url}/services/${s.id}`,
      provider: { '@id': `${SITE.url}/#organization` },
    },
  })),
};

const capabilities = [
  { icon: 'wallet', label: 'Cloud spend you can explain, team by team' },
  { icon: 'gauge', label: 'Deployment times measured in minutes, not evenings' },
  { icon: 'layers', label: 'Every environment described in code and reproducible' },
  { icon: 'users', label: 'Your team keeps the knowledge after we hand over' },
];
---

<Base
  title={SITE.title}
  description={SITE.description}
  schema={[serviceSchema]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-sand-100">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-ink-200 to-transparent"
    >
    </div>

    <div class="container-page relative py-20 lg:py-28">
      <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <div>
          <p
            data-reveal
            class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white px-3.5 py-1.5 text-xs font-medium text-ink-600"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
            AWS, Azure and GCP · Cloud engineering and DevOps
          </p>

          <h1 data-reveal data-reveal-delay="60" class="heading-1 mt-6 text-balance">
            The cloud team you don't have to hire
          </h1>

          <p data-reveal data-reveal-delay="120" class="lede mt-6 max-w-xl text-pretty">
            Senior cloud and DevOps engineers, on hand when the work calls for them. Migration and
            architecture, cost optimisation, CI/CD, Kubernetes and serverless, observability and
            security, across AWS, Azure and GCP. One team for the whole platform, not a specialist
            for each piece.
          </p>

          <div data-reveal data-reveal-delay="180" class="mt-9 flex flex-wrap gap-3">
            <Button href={AUDIT_APP_URL} size="lg">Get a free AWS audit</Button>
            <Button href="/work" variant="secondary" size="lg" icon={false}>
              See our case studies
            </Button>
          </div>

          <ul data-reveal data-reveal-delay="240" class="mt-11 grid gap-3.5 sm:grid-cols-2">
            {
              capabilities.map((c) => (
                <li class="flex items-start gap-2.5 text-sm text-ink-600">
                  <Icon name="check" size={17} class="mt-0.5 shrink-0 text-accent-600" />
                  {c.label}
                </li>
              ))
            }
          </ul>
        </div>

        <div data-reveal data-reveal-delay="140">
          <HeroVisual />
        </div>
      </div>
    </div>
  </section>

  <LogoMarquee />

  <!-- Services -->
  <section class="bg-white py-20 lg:py-28">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading
          eyebrow="Services"
          title="The whole platform, one team"
          lede="Eleven practices across cloud and DevOps. Engagements are scoped to what you actually need - we do not sell a package you have to grow into."
        />
        <Button href="/services" variant="secondary" class="hidden sm:inline-flex">
          All services
        </Button>
      </div>

      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service, i) => <ServiceCard service={service} index={i} />)}
      </div>

      <div class="mt-10 sm:hidden">
        <Button href="/services" variant="secondary">All services</Button>
      </div>
    </div>
  </section>

  <AuditOffer />

  <!-- Stats band -->
  <section class="bg-ink-950 py-16 lg:py-20">
    <div class="container-page">
      <Stats />
    </div>
  </section>

  <!-- Case studies -->
  <section class="bg-white py-20 lg:py-28">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading
          eyebrow="Case studies"
          title="Outcomes, not deliverables"
          lede="Every engagement below is measured against something the business cares about - uptime, latency, cost, or an audit that had to pass."
        />
        <Button href="/work" variant="secondary" class="hidden sm:inline-flex">
          All case studies
        </Button>
      </div>

      <div class="mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {work.map((item, i) => <WorkCard item={item} index={i} />)}
      </div>

      <div class="mt-10 sm:hidden">
        <Button href="/work" variant="secondary">All case studies</Button>
      </div>
    </div>
  </section>

  <TestimonialsSection />

  <!-- Blog -->
  <section class="bg-white py-20 lg:py-28">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading
          eyebrow="Insights"
          title="From our engineering desk"
          lede="Practical writing on cloud architecture, container orchestration and securing what you ship."
        />
        <Button href="/blog" variant="secondary" class="hidden sm:inline-flex">
          All articles
        </Button>
      </div>

      <div class="mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, i) => <BlogCard post={post} index={i} />)}
      </div>
    </div>
  </section>

  <CTA />
</Base>

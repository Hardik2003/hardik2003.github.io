---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base
  title="Page not found"
  description="The page you are looking for does not exist or has moved."
  noindex
>
  <section class="bg-sand-100">
    <div class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
      <p class="font-mono text-sm tracking-widest text-accent-600">404</p>
      <h1 class="heading-1 mt-5 max-w-xl text-balance">This page could not be found</h1>
      <p class="lede mt-6 max-w-lg">
        The link may be outdated, or the page may have moved during our site redesign.
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button href="/" size="lg">Back to home</Button>
        <Button href="/services" variant="secondary" size="lg" icon={false}>Browse services</Button>
      </div>
    </div>
  </section>
</Base>

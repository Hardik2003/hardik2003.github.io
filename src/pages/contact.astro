---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, CONTACT, WEB3FORMS } from '../consts';

/**
 * Static hosting has no backend, so enquiries go through Web3Forms, which
 * delivers them to CONTACT.email. The plain `action` attribute means the
 * form still works with JavaScript disabled; the script below intercepts
 * it to keep the visitor on the page and show inline status instead.
 */

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${SITE.name}`,
  url: `${SITE.url}/contact`,
  mainEntity: { '@id': `${SITE.url}/#organization` },
};

const fieldClass =
  'mt-2 block w-full rounded-lg border border-ink-200 bg-white px-3.5 py-2.5 text-sm text-ink-900 transition-colors placeholder:text-ink-300 focus:border-accent-600 focus:outline-none focus:ring-1 focus:ring-accent-600 aria-[invalid=true]:border-red-500 aria-[invalid=true]:focus:border-red-500 aria-[invalid=true]:focus:ring-red-500';

/** Hidden until the validator fills it in. */
const errorClass = 'mt-1.5 hidden text-xs text-red-600';

const services = [
  // One entry, because there is one audit - the scan covers exposure and
  // waste together rather than being two things you pick between.
  'Free AWS audit',
  'DevSecOps and secure CI/CD',
  'Cloud security and architecture',
  'Secure automation and pipelines',
  'IaC security and configuration',
  'Containers and Kubernetes',
  'Monitoring and incident response',
  'Cloud vulnerability assessment',
  'Penetration testing',
  'Code vulnerability assessment',
  'Something else',
];
---

<Base
  title="Contact us - talk to a senior engineer"
  description="Get in touch with ScionTech for DevSecOps, cloud security and secure CI/CD engagements. Free 30-minute assessment with a senior engineer, no obligation."
  breadcrumbs={[{ name: 'Contact', href: '/contact' }]}
  schema={[schema]}
>
  <section class="border-b border-ink-100 bg-sand-100">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-3xl">
        <p class="eyebrow">Get in touch</p>
        <h1 class="heading-1 mt-4 text-balance">Reach out to us</h1>
        <p class="lede mt-6 text-pretty">
          Tell us what you are building and where it hurts. We reply within one business day, and
          the first conversation is a technical one - not a sales call.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-24">
    <div class="container-page">
      <div class="grid gap-14 lg:grid-cols-[1fr_22rem] lg:gap-20">
        <!-- Form -->
        <div>
          <form
            id="enquiry-form"
            method="POST"
            action={WEB3FORMS.endpoint}
            class="space-y-6"
          >
            <input type="hidden" name="access_key" value={WEB3FORMS.accessKey} />
            <input type="hidden" name="from_name" value={`${SITE.name} website`} />
            <input type="hidden" name="subject" value="New enquiry from sciontech.co" />
            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label for="name" class="block text-sm font-medium text-ink-900">
                  Your name <span class="text-accent-600" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  minlength="2"
                  maxlength="80"
                  autocomplete="name"
                  autocapitalize="words"
                  spellcheck="false"
                  aria-describedby="name-error"
                  class={fieldClass}
                  placeholder="Jane Cooper"
                />
                <p id="name-error" class={errorClass} aria-live="polite"></p>
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-ink-900">
                  Work email <span class="text-accent-600" aria-hidden="true">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  maxlength="254"
                  autocomplete="email"
                  autocapitalize="off"
                  spellcheck="false"
                  inputmode="email"
                  aria-describedby="email-error"
                  class={fieldClass}
                  placeholder="jane@company.com"
                />
                <p id="email-error" class={errorClass} aria-live="polite"></p>
              </div>

              <div>
                <label for="company" class="block text-sm font-medium text-ink-900">
                  Company <span class="font-normal text-ink-400">(optional)</span>
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  maxlength="100"
                  autocomplete="organization"
                  aria-describedby="company-error"
                  class={fieldClass}
                  placeholder="Acme Inc."
                />
                <p id="company-error" class={errorClass} aria-live="polite"></p>
              </div>

              <div>
                <label for="phone" class="block text-sm font-medium text-ink-900">
                  Phone <span class="font-normal text-ink-400">(optional)</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  maxlength="25"
                  autocomplete="tel"
                  inputmode="tel"
                  pattern="[0-9+()\-.\s]{7,25}"
                  aria-describedby="phone-error"
                  class={fieldClass}
                  placeholder="+1 555 000 0000"
                />
                <p id="phone-error" class={errorClass} aria-live="polite"></p>
              </div>
            </div>

            <div>
              <label for="service" class="block text-sm font-medium text-ink-900">
                What do you need help with? <span class="text-accent-600" aria-hidden="true">*</span>
              </label>
              <select
                id="service"
                name="service"
                required
                aria-describedby="service-error"
                class={fieldClass}
              >
                <option value="">Select an option…</option>
                {services.map((s) => <option value={s}>{s}</option>)}
              </select>
              <p id="service-error" class={errorClass} aria-live="polite"></p>
            </div>

            <div>
              <div class="flex items-baseline justify-between gap-4">
                <label for="message" class="block text-sm font-medium text-ink-900">
                  Project brief <span class="text-accent-600" aria-hidden="true">*</span>
                </label>
                <span id="message-count" class="text-xs tabular-nums text-ink-400">0 / 2000</span>
              </div>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                minlength="20"
                maxlength="2000"
                aria-describedby="message-error"
                class={fieldClass}
                placeholder="What are you running today, what is going wrong, and what would a good outcome look like?"></textarea>
              <p id="message-error" class={errorClass} aria-live="polite"></p>
            </div>

            <!-- Web3Forms honeypot: bots fill this, humans never see it -->
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label for="botcheck">Do not fill this in</label>
              <input type="checkbox" id="botcheck" name="botcheck" tabindex="-1" />
            </div>

            <div class="flex flex-wrap items-center gap-4">
              <button
                type="submit"
                class="group inline-flex items-center gap-2 rounded-lg bg-ink-900 px-6 py-3.5 text-[0.9375rem] font-medium text-white transition-colors hover:bg-accent-600 disabled:opacity-60"
              >
                Submit enquiry
                <Icon
                  name="arrow-right"
                  size={18}
                  class="transition-transform duration-200 group-hover:translate-x-0.5"
                />
              </button>
              <p class="text-sm text-ink-400">We reply within one business day.</p>
            </div>

            <p
              id="form-status"
              role="status"
              aria-live="polite"
              class="hidden rounded-lg px-4 py-3 text-sm"
            >
            </p>
          </form>
        </div>

        <!-- Contact details -->
        <aside class="space-y-5 lg:sticky lg:top-28 lg:self-start">
          <a
            href={`mailto:${CONTACT.email}`}
            class="card card-hover group flex items-start gap-4 p-6"
          >
            <span
              class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-50 text-accent-600 transition-colors group-hover:bg-accent-600 group-hover:text-white"
            >
              <Icon name="mail" size={20} />
            </span>
            <div class="min-w-0">
              <h2 class="text-sm font-semibold text-ink-900">Email us</h2>
              <p class="mt-1 break-words text-sm text-ink-500">{CONTACT.email}</p>
            </div>
          </a>

          <a
            href={`tel:${CONTACT.phoneHref}`}
            class="card card-hover group flex items-start gap-4 p-6"
          >
            <span
              class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-50 text-accent-600 transition-colors group-hover:bg-accent-600 group-hover:text-white"
            >
              <Icon name="phone" size={20} />
            </span>
            <div>
              <h2 class="text-sm font-semibold text-ink-900">Call us</h2>
              <p class="mt-1 text-sm text-ink-500">{CONTACT.phone}</p>
            </div>
          </a>

          <div class="card flex items-start gap-4 p-6">
            <span
              class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-50 text-accent-600"
            >
              <Icon name="map-pin" size={20} />
            </span>
            <div>
              <h2 class="text-sm font-semibold text-ink-900">Visit us</h2>
              {
                CONTACT.offices.map((office, i) => (
                  <address
                    class:list={[
                      'text-sm not-italic leading-relaxed text-ink-500',
                      i === 0 ? 'mt-1' : 'mt-3',
                    ]}
                  >
                    <span class="font-medium text-ink-700">{office.city}</span>
                    <br />
                    {office.street && (
                      <>
                        {office.street}
                        <br />
                      </>
                    )}
                    {office.region}
                    {office.postalCode ? ` - ${office.postalCode}` : ''}, {office.countryName}
                  </address>
                ))
              }
            </div>
          </div>

          <a
            href={CONTACT.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="card card-hover group flex items-start gap-4 p-6"
          >
            <span
              class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-50 text-accent-600 transition-colors group-hover:bg-accent-600 group-hover:text-white"
            >
              <Icon name="linkedin" size={20} />
            </span>
            <div>
              <h2 class="text-sm font-semibold text-ink-900">Follow us</h2>
              <p class="mt-1 text-sm text-ink-500">LinkedIn</p>
            </div>
          </a>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ endpoint: WEB3FORMS.endpoint, email: CONTACT.email }}>
  const form = document.getElementById('enquiry-form');
  const status = document.getElementById('form-status');
  const button = form.querySelector('button[type="submit"]');
  const originalButton = button.innerHTML;

  // Take over from native validation so the messages are ours and consistent
  // across browsers. Left on in the markup so it still applies without JS.
  form.setAttribute('novalidate', '');

  const EMAIL = /^[^\s@]+@[^\s@,]+\.[A-Za-z]{2,}$/;
  const PHONE_ALLOWED = /^[0-9+()\-.\s]+$/;
  const HAS_LETTER = /\p{L}/u;
  const LOOKS_LIKE_URL = /(https?:\/\/|www\.)/i;

  const rules = {
    name(v) {
      if (!v) return 'Please enter your name.';
      if (v.length < 2) return 'That looks too short - please enter your full name.';
      if (v.length > 80) return 'Please keep this under 80 characters.';
      if (!HAS_LETTER.test(v)) return 'Please enter a name using letters.';
      if (LOOKS_LIKE_URL.test(v)) return 'Please enter a name, not a link.';
      return '';
    },
    email(v) {
      if (!v) return 'Please enter your email so we can reply.';
      if (v.length > 254) return 'That email address is too long.';
      if (!EMAIL.test(v)) return 'That does not look like a valid email address.';
      return '';
    },
    company(v) {
      if (v && v.length > 100) return 'Please keep this under 100 characters.';
      return '';
    },
    phone(v) {
      if (!v) return '';
      if (!PHONE_ALLOWED.test(v)) return 'Phone can only contain digits, spaces and + ( ) - .';
      const digits = v.replace(/\D/g, '');
      if (digits.length < 7) return 'That phone number looks too short.';
      if (digits.length > 15) return 'That phone number looks too long.';
      return '';
    },
    service(v) {
      if (!v) return 'Please choose what you need help with.';
      return '';
    },
    message(v) {
      if (!v) return 'Please tell us a little about your project.';
      if (v.length < 20) return `A bit more detail please - ${20 - v.length} more characters.`;
      if (v.length > 2000) return 'Please keep this under 2000 characters.';
      if (!HAS_LETTER.test(v)) return 'Please describe your project in words.';
      return '';
    },
  };

  const fieldNames = Object.keys(rules);
  const touched = new Set();

  const setError = (name, message) => {
    const input = form.elements[name];
    const slot = document.getElementById(`${name}-error`);
    if (!input || !slot) return;

    if (message) {
      input.setAttribute('aria-invalid', 'true');
      slot.textContent = message;
      slot.classList.remove('hidden');
    } else {
      input.removeAttribute('aria-invalid');
      slot.textContent = '';
      slot.classList.add('hidden');
    }
  };

  const validate = (name) => {
    const input = form.elements[name];
    if (!input) return true;
    const value = String(input.value ?? '').trim();
    const message = rules[name](value);
    setError(name, touched.has(name) ? message : '');
    return !message;
  };

  fieldNames.forEach((name) => {
    const input = form.elements[name];
    if (!input) return;

    // Only show an error once the visitor has finished with the field -
    // flagging "invalid email" on the first keystroke is hostile.
    input.addEventListener('blur', () => {
      touched.add(name);
      validate(name);
    });
    input.addEventListener('input', () => {
      if (touched.has(name)) validate(name);
    });
    input.addEventListener('change', () => {
      touched.add(name);
      validate(name);
    });
  });

  // Strip characters the phone field can never accept, as they are typed.
  const phone = form.elements.phone;
  phone.addEventListener('input', () => {
    const cleaned = phone.value.replace(/[^0-9+()\-.\s]/g, '');
    if (cleaned !== phone.value) {
      const pos = phone.selectionStart - (phone.value.length - cleaned.length);
      phone.value = cleaned;
      phone.setSelectionRange(pos, pos);
    }
  });

  // Live character count, and warn as the limit approaches.
  const message = form.elements.message;
  const counter = document.getElementById('message-count');
  const updateCount = () => {
    const n = message.value.length;
    counter.textContent = `${n} / 2000`;
    counter.classList.toggle('text-red-600', n > 1900);
    counter.classList.toggle('text-ink-400', n <= 1900);
  };
  message.addEventListener('input', updateCount);
  updateCount();

  // A reset (ours after a send, or the browser restoring state) has to clear
  // the counter and any errors too, or they linger against empty fields.
  form.addEventListener('reset', () => {
    window.setTimeout(() => {
      touched.clear();
      fieldNames.forEach((n) => setError(n, ''));
      updateCount();
    }, 0);
  });

  const show = (message, ok) => {
    status.textContent = message;
    status.className = ok
      ? 'rounded-lg bg-accent-50 px-4 py-3 text-sm text-accent-800'
      : 'rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700';
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    // Guard against a double submit while a request is in flight.
    if (button.disabled) return;

    // Validate everything, then send focus to the first problem.
    fieldNames.forEach((n) => touched.add(n));
    const invalid = fieldNames.filter((n) => !validate(n));

    if (invalid.length > 0) {
      const first = form.elements[invalid[0]];
      first.focus({ preventScroll: true });
      first.scrollIntoView({ behavior: 'smooth', block: 'center' });
      show(
        invalid.length === 1
          ? 'One field needs attention before we can send this.'
          : `${invalid.length} fields need attention before we can send this.`,
        false
      );
      return;
    }

    const data = new FormData(form);

    // Normalise whitespace so trailing spaces do not reach the inbox.
    fieldNames.forEach((n) => data.set(n, String(data.get(n) ?? '').trim()));

    // Make the notification email useful at a glance, and let a plain
    // "Reply" in the inbox go straight back to the enquirer.
    const service = data.get('service');
    const name = data.get('name');
    data.set('subject', `${service || 'Enquiry'} - ${name || 'website enquiry'}`);
    data.set('replyto', String(data.get('email') ?? ''));

    button.disabled = true;
    button.textContent = 'Sending…';
    status.className = 'hidden';

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });

      const result = await response.json().catch(() => ({}));

      if (response.ok && result.success) {
        form.reset();
        touched.clear();
        fieldNames.forEach((n) => setError(n, ''));
        updateCount();
        show('Thanks - your enquiry is with us. We will reply within one business day.', true);
      } else {
        show(
          `${result.message || 'That did not send.'} Please email us directly at ${email}.`,
          false
        );
      }
    } catch {
      show(`Something went wrong sending that. Please email us directly at ${email}.`, false);
    } finally {
      button.disabled = false;
      button.innerHTML = originalButton;
    }
  });
</script>
